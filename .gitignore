# Dependencies - regenerate these with `npm install`, never commit them
node_modules/

# Build output - regenerate with `npm run build`
dist/
dist-ssr/
*.local

# Environment files - these hold secrets and API keys. Never commit them.
.env
.env.local
.env.*.local

# Editor and OS clutter
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vercel
.vercel
